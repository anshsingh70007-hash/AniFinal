<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same set as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/watchlist_preferences.preferences_pb"/>
        <include domain="file" path="datastore/watch_history_preferences.preferences_pb"/>
        <include domain="file" path="datastore/settings_preferences.preferences_pb"/>
        <include domain="file" path="datastore/user_feedback_preferences.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/watchlist_preferences.preferences_pb"/>
        <include domain="file" path="datastore/watch_history_preferences.preferences_pb"/>
        <include domain="file" path="datastore/settings_preferences.preferences_pb"/>
        <include domain="file" path="datastore/user_feedback_preferences.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
